# Caddy auto-provisions Let's Encrypt certs for every hostname and reverse-proxies
# to the stack. FLEET_HOST / SUPABASE_HOST (and the optional space-separated
# *_ALIASES, served identically during a host move) come from .env via
# docker-compose.prod.yml; DNS for each must point at this server and ports
# 80/443 must be open.

{$FLEET_HOST} {$FLEET_HOST_ALIASES} {
	encode zstd gzip
	# Driver token exchange lives in its own internal service (the sanctioned
	# secret-key holder) — one route, everything else goes to the app.
	handle /api/driver-session {
		reverse_proxy driver-session:3100
	}
	handle {
		reverse_proxy app:3000
	}
}

{$SUPABASE_HOST} {$SUPABASE_HOST_ALIASES} {
	reverse_proxy kong:8000
}
