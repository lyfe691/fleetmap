# Caddy auto-provisions a Let's Encrypt cert for this hostname and reverse-proxies
# to the Next app. Requires the domain's DNS to point at this VPS and ports 80/443
# open. Change the hostname if you move off the Hostinger subdomain.

fleet.ysz.life {
	encode zstd gzip
	# Driver token exchange lives in its own internal service (the sanctioned
	# secret-key holder) — one route, everything else goes to the app.
	handle /api/driver-session {
		reverse_proxy driver-session:3100
	}
	handle {
		reverse_proxy app:3000
	}
}

sb.fleet.ysz.life {
	reverse_proxy kong:8000
}
