# Supabase — copy this file to .env. Dev runs against the local CLI stack:
# `pnpm supabase start` (then `pnpm supabase db reset` to apply migrations + seed)
# prints these three values. Local API is http://127.0.0.1:44321 (ports are
# shifted from the Supabase defaults — see supabase/config.toml).
# Prod (self-hosted VPS) values live on the VPS only; the retired managed-cloud
# rollback values live in .env.cloud (gitignored). Never paste either here.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:44321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dev/scripts only (e.g. scripts/fake-gps.ts, scripts/provision-dashboard.ts).
# Bypasses RLS — never import this in a route handler or ship it in a deployed image.
SUPABASE_SECRET_KEY=

# Map tiles come from OpenFreeMap (tiles.openfreemap.org) — free, keyless,
# no request limits. No env var needed. Never the public OSM tile server.

# OSRM routing proxy target — SERVER-ONLY (GET /api/route reaches it; OSRM stays
# internal). Dev: http://localhost:5000 (the docker-compose `osrm` service).
# Once the app joins the compose stack, use the service name: http://osrm:5000.
OSRM_URL=http://localhost:5000

# Driver-session liveness target — SERVER-ONLY. Optional in local development;
# production Compose injects http://driver-session:3100 so login health gates
# GET /api/health there.
DRIVER_SESSION_URL=

# Read-only dashboard ("display token") — SERVER-ONLY. Do NOT prefix any of these
# NEXT_PUBLIC_ or they leak into the client bundle and defeat the gate.
DASHBOARD_EMAIL=dashboard@fleetmap.internal
DASHBOARD_PASSWORD=
DASHBOARD_DISPLAY_CODE=

# Dispatcher identity (ingestion writer) — SERVER-ONLY. Do NOT prefix NEXT_PUBLIC_.
# DISPATCHER_INGEST_SECRET gates POST /api/dispatcher-session (the session mint),
# exactly like DASHBOARD_DISPLAY_CODE gates the dashboard session.
DISPATCHER_EMAIL=dispatcher@fleetmap.internal
DISPATCHER_PASSWORD=
DISPATCHER_INGEST_SECRET=

# Standalone test driver (pnpm provision-driver) — a driver + vehicle NOT driven
# by fake-gps, safe to hand to the native driver app for live testing.
TEST_DRIVER_EMAIL=driver-test@fleetmap.app
TEST_DRIVER_PASSWORD=
TEST_DRIVER_LABEL=Test Van

# Driver session exchange (workers/driver-session.ts) — trades a Bubble Box
# rider token for a Supabase session. It no longer verifies signatures itself:
# it calls Bubble Box's /fleet/verify-rider-token with the SAME BB_API_*
# credentials the route sync uses (below), so there is no separate variable
# here. On the VPS those three go in .env.driver-session (own file, never the
# shared .env; see docker-compose.prod.yml) alongside SUPABASE_SECRET_KEY.

# Bubble Box route sync (workers/bubblebox-sync.ts) and the driver session
# exchange — SERVER/WORKER-ONLY.
# The username/password mint a 24h token against their fleet API
# (staging: https://upgrade.bubblebox.ch). For offline dev, leave these empty
# and point BB_FIXTURE_FILE at a BBRoute[] JSON instead.
BB_API_URL=
BB_API_USERNAME=
BB_API_PASSWORD=

# Staging test rider for self-serving a 2-minute fleetAuthToken
# (scripts/mint-fleet-auth-token.ts). The rider login lives under /shop.
BB_TEST_RIDER_USERNAME=
BB_TEST_RIDER_PASSWORD=
BB_SYNC_INTERVAL_MS=60000
FLEETMAP_API_URL=http://localhost:3000
BB_FIXTURE_FILE=
